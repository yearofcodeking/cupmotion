{
  "_about": "Словарь триггеров cupmotion. video — сильные слова: сообщение точно про ролик. soft — мягкие слова: считаются, только если в сообщении нет ничего из notVideo (код интерфейса). routes — что подключать: match срабатывает, когда сообщение про ролик (маршрут flow с match [\"[\\\\s\\\\S]\"] срабатывает на любой ролик и всегда подключает справочники плавности и связности); solo — срабатывает даже без слов про ролик. styles — разделы references/styles.md, refs — файлы references/, sites, tips. Регулярки JavaScript, флаги iu. Короткое сообщение (до longMessage = 600 знаков) подключает всё названное. В длинном (вставленный бриф или документ) маршруту нужны два его слова (solo считается вдвое; повтор слова и слово после «стиль» тоже засчитываются как второе), и подкладывается не больше maxRoutes (5) маршрутов и maxStyles (4) стилевых разделов; маршрут с always: true в лимит не входит, отброшенное хук называет одной строкой. Свои слова — в ~/.claude/cupmotion.routes.json (та же форма, сливается сверху и не стирается обновлением).",
  "video": ["моуш[еэ]?н", "motion[\\s-]?(graphics?|design|video)", "(?<![\\p{L}])видео(?!карт)", "видеоролик", "(?<![\\p{L}])ролик", "(?<![\\p{L}])мульт(?:ик|фильм|ипликац|(?![\\p{L}]))", "(?<![\\p{L}])промо(?!код|\\p{L}*акц)", "промо-?ролик", "шоурил", "showreel", "(?<![\\p{L}])клип(?!борд|арт)", "объяснялк", "explainer", "кинетическ\\p{L}* типограф", "kinetic typo", "(?<![\\p{L}])шортс", "(?<![\\p{L}])reels?(?![\\p{L}])", "\\.mp4(?![\\p{L}])", "cupmotion"],
  "soft": ["анимац", "анимир", "заставк", "(?<![\\p{L}])интро(?![\\p{L}])", "(?<![\\p{L}])аутро(?![\\p{L}])", "(?<![\\p{L}])motion(?![\\p{L}])", "кинетическ", "kinetic"],
  "notVideo": ["css", "кнопк", "модалк", "модальн", "hover", "ховер", "transition", "keyframes", "компонент", "component", "react", "framer", "tailwind", "jsx", "tsx", "вёрстк|верстк", "onClick", "useEffect", "emotion", "promotion", "лоадер|loader|спиннер|spinner"],
  "routes": [
    {
      "id": "flow", "label": "Плавность и связность", "always": true,
      "match": ["[\\s\\S]"],
      "solo": ["(?<![\\p{L}\\p{N}])3[\\s-]?[дdD](?![\\p{L}])", "(?<![\\p{L}\\p{N}])2[,.]5[\\s-]?[дdD](?![\\p{L}])", "шоурил", "showreel"],
      "styles": [],
      "refs": ["flow-brief.md"],
      "sites": [],
      "tips": ["Склеек и эффектов-переходов нет, пока пользователь прямо не попросил жёсткий монтаж: кадр идёт за кадром, смена места делается движением внутри одного мира."]
    },
    {
      "id": "3d", "label": "3D",
      "match": ["(?<![\\p{L}\\p{N}])3[\\s-]?[дdD](?![\\p{L}])", "тр[её]хмерн", "объ[её]мн", "three\\.?js", "webgl", "blender|блендер"],
      "solo": ["(?<![\\p{L}\\p{N}])3[\\s-]?[дdD](?![\\p{L}])"],
      "styles": ["premium-3d", "depth-3d"],
      "refs": ["3d.md"],
      "tips": ["Свечение, глубина резкости, хроматическая аберрация, загрузка three из CDN и seek-рецепт — в libs.md, раздел «three + postprocessing» (Grep по заголовку), не весь файл."],
      "sites": [
        {"name": "Poly Haven — модели CC0", "url": "https://polyhaven.com/models"},
        {"name": "Kenney — 3D-наборы CC0", "url": "https://kenney.nl/assets/category:3D"},
